{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daruks-com",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  },
  "routes": [
    { "pattern": "daruks.com/*", "zone_name": "daruks.com" },
    { "pattern": "www.daruks.com/*", "zone_name": "daruks.com" }
  ]
}
