{
  "name": "main",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "description": "daruks.com の個人ホームページです。",
  "main": "script.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "css": "node scripts/css.mjs",
    "check": "pwsh -NoProfile -File scripts/check.ps1",
    "hooks:install": "pwsh -NoProfile -File scripts/install-git-hooks.ps1",
    "prepare": "pwsh -NoProfile -File scripts/install-git-hooks.ps1",
    "contact:dev": "pnpm --filter contact-app dev",
    "contact:build": "pnpm --filter contact-app build",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "init-config": "tailwindcss init",
    "worker:dev": "wrangler dev --persist-to ../.daruks-com-wrangler-state",
    "worker:types": "wrangler types",
    "deploy": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darui3018823/main.git"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/darui3018823/main/issues"
  },
  "homepage": "https://github.com/darui3018823/main#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.2"
  }
}
